# Copy to .env for running the API on the host (outside Docker).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Matches the `db` service in docker-compose.yml (host port 5433).
DATABASE_URL=postgres://borderless:borderless@localhost:5433/borderless
DB_POOL_MAX=10

# Swagger UI at /docs. On by default, except when NODE_ENV=production.
ENABLE_DOCS=true

# Live FX provider (USD base). On failure the API falls back to the last good
# snapshot, then to the static rate table in src/modules/rates/static-rates.ts.
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_TIMEOUT_MS=5000
FX_CACHE_TTL_SECONDS=300
# How long the last good rates may be reused while the provider is failing (48 hours).
FX_MAX_STALE_SECONDS=172800
