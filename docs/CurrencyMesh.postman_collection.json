{
  "info": {
    "name": "CurrencyMesh API",
    "description": "End-to-end walkthrough of the CurrencyMesh API. Start the stack with `docker compose up`, then use **Run collection**: requests run in order and pass IDs to each other through collection variables.\n\nEvery money-moving request sends a fresh `Idempotency-Key` ({{$guid}}). The *Idempotency* folder shows a retry being replayed instead of charged twice.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "senderId",
      "value": ""
    },
    {
      "key": "receiverId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "replayKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health and rates",
      "item": [
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API and database are ready', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ready');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Current FX rates",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/rates"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json().data;",
                  "pm.test('returns all 20 pairs with refresh times', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(res.rates).to.have.lengthOf(20);",
                  "  pm.expect(res.rates[0]).to.have.property('refreshedAt');",
                  "  pm.expect(['live', 'stale', 'static']).to.include(res.source);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Wallets",
      "item": [
        {
          "name": "Create sender wallet (email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/wallets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$randomEmail}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json().data;",
                  "pm.test('wallet created with five zero balances', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(res.balances).to.have.lengthOf(5);",
                  "});",
                  "pm.collectionVariables.set('senderId', res.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create receiver wallet (phone)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A random valid Nigerian mobile number, so the collection can run repeatedly.",
                  "const digits = String(Math.floor(Math.random() * 1e7)).padStart(7, '0');",
                  "pm.variables.set('receiverPhone', `+234 803 ${digits.slice(0, 3)} ${digits.slice(3)}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json().data;",
                  "pm.test('phone stored in E.164', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(res.phone).to.match(/^\\+234\\d{10}$/);",
                  "});",
                  "pm.collectionVariables.set('receiverId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/wallets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{receiverPhone}}\"\n}"
            }
          }
        },
        {
          "name": "Get sender wallet",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/wallets/{{senderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns the wallet', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('senderId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Move money",
      "item": [
        {
          "name": "Deposit 100 USDx",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/v1/wallets/{{senderId}}/deposits",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"USDx\",\n  \"amount\": \"100.00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json().data;",
                  "pm.test('deposit recorded', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(res.type).to.eql('DEPOSIT');",
                  "  pm.expect(res.destination).to.eql({ currency: 'USDx', amount: '100.000000' });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Swap 40 USDx to cNGN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/v1/wallets/{{senderId}}/swaps",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromCurrency\": \"USDx\",\n  \"toCurrency\": \"cNGN\",\n  \"amount\": \"40\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json().data;",
                  "pm.test('swap recorded with the rate used', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(res.type).to.eql('SWAP');",
                  "  pm.expect(res.source.amount).to.eql('40.000000');",
                  "  pm.expect(Number(res.fx.rate)).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer 20 USDx, received as cGHS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/v1/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromWalletId\": \"{{senderId}}\",\n  \"toWalletId\": \"{{receiverId}}\",\n  \"sourceCurrency\": \"USDx\",\n  \"destinationCurrency\": \"cGHS\",\n  \"amount\": \"20\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json().data;",
                  "pm.test('transfer records both sides and the rate', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(res.fromWalletId).to.eql(pm.collectionVariables.get('senderId'));",
                  "  pm.expect(res.toWalletId).to.eql(pm.collectionVariables.get('receiverId'));",
                  "  pm.expect(res.source.currency).to.eql('USDx');",
                  "  pm.expect(res.destination.currency).to.eql('cGHS');",
                  "  pm.expect(res.fx).to.have.property('rate');",
                  "  pm.expect(res).to.have.property('createdAt');",
                  "});",
                  "pm.collectionVariables.set('transactionId', res.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sender balances with total in USD",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/wallets/{{senderId}}/balances"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json().data;",
                  "const usdx = res.balances.find((b) => b.currency === 'USDx');",
                  "pm.test('100 - 40 swapped - 20 sent = 40 USDx left', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(usdx.amount).to.eql('40.000000');",
                  "  pm.expect(res).to.have.property('totalUsd');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. History",
      "item": [
        {
          "name": "Sender history (newest first)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/wallets/{{senderId}}/transactions?limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('transfer, swap, deposit, newest first', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.data.map((t) => t.type)).to.eql(['TRANSFER', 'SWAP', 'DEPOSIT']);",
                  "  pm.expect(body.data[0].direction).to.eql('OUT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Receiver history, transfers only",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/wallets/{{receiverId}}/transactions?type=TRANSFER&currency=cGHS"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('receiver sees the transfer as IN', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.data).to.have.lengthOf(1);",
                  "  pm.expect(body.data[0].direction).to.eql('IN');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one transaction",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/transactions/{{transactionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns the transfer', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('transactionId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Idempotency",
      "item": [
        {
          "name": "Deposit 5 cXAF (first attempt)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('replayKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('processed', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.response.to.have.header('Idempotent-Replayed', 'false');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{replayKey}}"
              }
            ],
            "url": "{{baseUrl}}/v1/wallets/{{senderId}}/deposits",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"cXAF\",\n  \"amount\": \"5\"\n}"
            }
          }
        },
        {
          "name": "Same request again (replayed, not charged)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{replayKey}}"
              }
            ],
            "url": "{{baseUrl}}/v1/wallets/{{senderId}}/deposits",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"cXAF\",\n  \"amount\": \"5\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('replayed from the first response', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.response.to.have.header('Idempotent-Replayed', 'true');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key, different amount (rejected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{replayKey}}"
              }
            ],
            "url": "{{baseUrl}}/v1/wallets/{{senderId}}/deposits",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"cXAF\",\n  \"amount\": \"6\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 IDEMPOTENCY_KEY_REUSED', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_KEY_REUSED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Sender cXAF balance is 5, not 10",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/wallets/{{senderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cxaf = pm.response.json().data.balances.find((b) => b.currency === 'cXAF');",
                  "pm.test('credited once', () => pm.expect(cxaf.amount).to.eql('5.000000'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Errors",
      "item": [
        {
          "name": "Overspend (422 INSUFFICIENT_FUNDS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/v1/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromWalletId\": \"{{senderId}}\",\n  \"toWalletId\": \"{{receiverId}}\",\n  \"sourceCurrency\": \"USDx\",\n  \"amount\": \"1000000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const { error } = pm.response.json();",
                  "pm.test('rejected with the available amount', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(error.code).to.eql('INSUFFICIENT_FUNDS');",
                  "  pm.expect(error.details.available).to.eql('40.000000');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Amount as a JSON number (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/v1/wallets/{{senderId}}/deposits",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"USDx\",\n  \"amount\": 10.5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('amounts must be strings', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing Idempotency-Key (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/wallets/{{senderId}}/deposits",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"USDx\",\n  \"amount\": \"1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('key is required', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_KEY_REQUIRED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
